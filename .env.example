# Copy to .env; never commit real credentials.
FCZHK_ENV=production
FCZHK_DATABASE_URL=postgresql+psycopg://fczhk:change-me@localhost:5432/fczhk
FCZHK_BOT_TOKEN=
FCZHK_COMMUNITY_CHAT_ID=
FCZHK_PUBLICATION_CHAT_ID=
# Required: numeric Telegram ID of the owner. Set a real ID before production.
# The owner manages other administrators in the app and cannot be demoted there.
FCZHK_OWNER_ID=0
# Optional legacy bootstrap list. If OWNER_ID=0, its first ID is the owner.
# Explicit grants/revocations saved by the owner override this list.
FCZHK_ADMIN_IDS=
FCZHK_PUBLIC_URL=https://football.example.com
FCZHK_BOT_USERNAME=
# Browser login: Client ID from BotFather > Login Widget; 0 disables it.
# Switch legacy Login Widget to OpenID Connect; register FCZHK_PUBLIC_URL in Trusted Origins.
# Redirect URLs are not used by this JavaScript flow. Keep signing algorithm RS256.
# The JavaScript login flow does not need a Client Secret.
FCZHK_TELEGRAM_LOGIN_CLIENT_ID=0
FCZHK_WEBHOOK_SECRET=
# Optional: set when using webhook mode. Polling is available via uv run fczhk bot.
FCZHK_AUTH_MAX_AGE_SECONDS=300
FCZHK_SESSION_HOURS=12
FCZHK_MEMBERSHIP_CACHE_SECONDS=300
# Allow an underfilled match with 0 or 1 goalkeeper; make the shortage explicit.
FCZHK_MIN_FIELD_PLAYERS=2
FCZHK_REQUIRE_TWO_KEEPERS=false
FCZHK_AUTH_IP_LIMIT=30
FCZHK_AUTH_GLOBAL_LIMIT=300
FCZHK_WORKER_STALE_SECONDS=120
FCZHK_PUBLICATION_STALE_SECONDS=300
# Random separate bearer token for Prometheus; empty disables /api/metrics.
FCZHK_METRICS_TOKEN=
# For direct Uvicorn access trust only your proxy. Compose sets "*" on its private network.
FCZHK_FORWARDED_ALLOW_IPS=127.0.0.1

# Docker deployment: database host is db:5432, not localhost.
# Set a strong password and use the same value (URL-encoded) in FCZHK_DATABASE_URL.
POSTGRES_PASSWORD=
DOMAIN=football.example.com
# If another service uses 443, enable the 8443 override (Compose >= 2.24.4).
# COMPOSE_FILE=compose.yaml:deploy/compose.8443.yaml
# Then set FCZHK_PUBLIC_URL=https://football.example.com:8443 above.
# Keep DOMAIN as the hostname only. Ports 80 and 8443 must be reachable.
# Tested GHCR image: full Git SHA tag, or preferably @sha256:digest.
# scripts/deploy.sh records the selected image in .local/release-image.
FCZHK_IMAGE=
